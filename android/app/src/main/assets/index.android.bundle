9b\u914d\u5408\u7a33\u5b9a\u65b9\u5411\uff0c\u624d\u80fd\u66f4\u597d\u53d1\u6325\u3002'},{cards:[2,18],en:'Strong intuition still benefits from checking uncertain assumptions.',zh:'\u5373\u4f7f\u76f4\u89c9\u5f3a\u70c8\uff0c\u4e5f\u5e94\u6838\u5b9e\u4e0d\u786e\u5b9a\u7684\u5224\u65ad\u3002'},{cards:[3,21],en:'Patient growth and completion belong to the same longer process.',zh:'\u8010\u5fc3\u6210\u957f\u4e0e\u9636\u6bb5\u5706\u6ee1\u5c5e\u4e8e\u540c\u4e00\u5386\u7a0b\u3002'},{cards:[0,8],en:'Curiosity is strongest when balanced with patience.',zh:'\u597d\u5947\u5fc3\u82e5\u80fd\u914d\u5408\u8010\u5fc3\uff0c\u4f1a\u66f4\u7a33\u59a5\u3002'},{cards:[5,20],en:'Old lessons may offer fresh perspective when reviewed honestly.',zh:'\u91cd\u65b0\u5ba1\u89c6\u8fc7\u53bb\u7684\u7ecf\u9a8c\uff0c\u53ef\u80fd\u5e26\u6765\u65b0\u9886\u609f\u3002'},{cards:[12,14],en:'A pause can help restore balance.',zh:'\u9002\u65f6\u505c\u987f\u6709\u52a9\u4e8e\u6062\u590d\u5e73\u8861\u3002'},{cards:[7,16],en:'Rapid movement and disruption invite a slower, steadier response.',zh:'\u5feb\u901f\u63a8\u8fdb\u9047\u4e0a\u53d8\u52a8\u65f6\uff0c\u66f4\u9700\u8981\u7a33\u6b65\u5e94\u5bf9\u3002'},{cards:[10,18],en:'Uncertainty is a reason to verify, not to predict.',zh:'\u9762\u5bf9\u4e0d\u786e\u5b9a\u6027\uff0c\u5e94\u6838\u5b9e\u4fe1\u606f\u800c\u975e\u5984\u4e0b\u9884\u6d4b\u3002'},{cards:[17,19],en:'Hope and clarity can reinforce a grounded outlook.',zh:'\u5e0c\u671b\u4e0e\u6e05\u6670\u7684\u601d\u8def\u80fd\u591f\u4e92\u76f8\u652f\u6301\u3002'}];function f(n,i){var t=r(_d[0]).QUESTIONS.find(i=>i.id===n);if(!t)throw Error('Unknown question');if(i.length!==t.positions.length)throw Error('Wrong number of cards');for(var o=new Set,a=0;a<i.length;a++){var s=i[a];if(!Number.isInteger(s.cardId)||s.cardId<0||s.cardId>=r(_d[0]).CARDS.length||o.has(s.cardId))throw Error('Invalid or duplicate card');if(s.position!==t.positions[a]||!['upright','reversed'].includes(s.orientation))throw Error('Invalid position/or